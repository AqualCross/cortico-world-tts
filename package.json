{
  "name": "cortico-world-tts",
  "version": "0.1.4",
  "type": "module",
  "description": "文本转语音（Text to Speech）—— 给 Coopanion 桌宠的 cortico World 扩展：把文字合成为语音，音频落盘并作为附件交回对话；也可以先回执、完成后发声音事件，并把桌宠气泡自动合成成语音事件。 / A cortico World extension that turns text into speech through a configurable TTS API and returns the audio as a conversation attachment; it can also deliver the audio later as an event and synthesize the pet's bubbles automatically.",
  "license": "MIT",
  "author": {
    "name": "AqualCross"
  },
  "homepage": "https://github.com/AqualCross/cortico-world-tts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AqualCross/cortico-world-tts.git"
  },
  "bugs": {
    "url": "https://github.com/AqualCross/cortico-world-tts/issues"
  },
  "keywords": [
    "cortico-world",
    "cortico",
    "coopanion",
    "tts",
    "text-to-speech",
    "speech-synthesis",
    "openai-compatible",
    "qwen"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "dist",
    "describe.json",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "selfcheck": "node tools/check.mjs",
    "prepublishOnly": "node tools/check.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "文本转语音",
    "tags": [
      "voice"
    ],
    "webUiClient": "dist/webui.js",
    "describe": "describe.json"
  }
}
